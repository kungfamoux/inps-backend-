# Required — server exits on boot if any of these are missing.
DATABASE_URL=
SERVICE_ACCOUNT_KEY=
FIREBASE_API_KEY=

# Recommended — related features degrade (log a warning, fail at request time)
# if these are missing, but the server still starts.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
RESEND_API_KEY=
RESEND_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Optional
PORT=3000
CORS_ORIGIN=
BASE_URL=
RENDER_EXTERNAL_URL=
SCHOOL_PHONE=
SCHOOL_WEBSITE=

# Seed data (npm run seed) — first two admin accounts.
# Up to 10 admin accounts can be created in total.
# Default password is the phone number, digits only.
ADMIN_1_EMAIL=
ADMIN_1_PHONE=
ADMIN_2_EMAIL=
ADMIN_2_PHONE=
